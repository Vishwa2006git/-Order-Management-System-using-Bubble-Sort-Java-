rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, role
    //
    // Collection: menu
    // Fields: name, price, description, imageUrl, category
    //
    // Collection: orders
    // Fields: customerId, customerName, items, totalAmount, status, createdAt, rating, feedback, aiAnalysis
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
         request.auth.token.email == "vishwa462006@gmail.com");
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.customerId;
    }

    // Validation Functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['owner', 'customer'];
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'description']) &&
             data.name is string && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.description is string && data.description.size() < 1000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'items', 'totalAmount', 'status', 'createdAt']) &&
             data.customerId is string &&
             data.items is list &&
             data.totalAmount is number &&
             data.status in ['pending', 'completed', 'cancelled'];
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (isUser(userId) || isOwner());
      allow create: if isAuthenticated() && isUser(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isUser(userId) || isOwner()) && isValidUser(request.resource.data);
    }

    match /menu/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() && isValidMenuItem(request.resource.data);
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (isDocOwner() || isOwner());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aiAnalysis'])) ||
        (isDocOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'feedback']))
      );
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
